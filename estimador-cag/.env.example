# =============================================================
# Estimador CAG · variables de entorno
# Copia este archivo como .env y rellena tus valores.
# El .env NUNCA se sube al repositorio (está en .gitignore).
# =============================================================

# --- Credenciales de los proveedores de LLM ------------------
# Solo es obligatoria la key del proveedor elegido en LLM_PROVIDER.
# Valores de ejemplo (NO son reales): sustitúyelos por tus keys en el .env.
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Proveedor y modelo --------------------------------------
# LLM_PROVIDER: openai | anthropic
# Modelos económicos recomendados: gpt-4o-mini (OpenAI) · claude-haiku-4-5 (Anthropic)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# --- Aplicación ----------------------------------------------
# APP_ENV: entorno de ejecución (development, production...)
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
APP_ENV=development
LOG_LEVEL=DEBUG
